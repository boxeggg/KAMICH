<?xml version="1.0" encoding="utf-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:KAMICH.Pages"
       x:Class="KAMICH.AppShell">

    <TabBar>
        <ShellContent Title="Home" Route="home" ContentTemplate="{DataTemplate local:LandingPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf015;" FontFamily="FASolid" Size="20" Color="Black"/>
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent Title="Flota" Route="fleet" ContentTemplate="{DataTemplate local:FleetPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf1b9;" FontFamily="FASolid" Size="20" Color="Black"/>
            </ShellContent.Icon>
        </ShellContent>

        <ShellContent Title="Ustawienia" Route="settings" ContentTemplate="{DataTemplate local:SettingsPage}">
            <ShellContent.Icon>
                <FontImageSource Glyph="&#xf013;" FontFamily="FASolid" Size="20" Color="Black"/>
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>