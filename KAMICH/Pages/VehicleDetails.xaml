<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="KAMICH.Pages.VehicleDetails"
    Title="{Binding Name, FallbackValue='Szczegóły pojazdu'}">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="12">
            <Frame CornerRadius="10" Padding="10" HasShadow="False" BackgroundColor="{DynamicResource PageBackgroundColor}">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="10">

                    <!-- Lewa strona: nazwa + opis -->
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label
                            Text="{Binding Name, FallbackValue='(brak nazwy)'}"
                            FontSize="20"
                            FontAttributes="Bold"
                            LineBreakMode="TailTruncation" />
                        <Label
                            Text="Podsumowanie użytkowania pojazdu"
                            FontSize="12"
                            Opacity="0.7" />
                    </VerticalStackLayout>

                    <!-- Prawa strona: ikony akcji -->
                    <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">

                        <HorizontalStackLayout Grid.Column="1" Spacing="16" VerticalOptions="Center">
                            <Label
                                Text="&#xf013;"
                                FontFamily="FASolid"
                                FontSize="22"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnCustomizeTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </HorizontalStackLayout>

                        
                    </HorizontalStackLayout>
                </Grid>
            </Frame>


            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="8">

                <Frame Style="{StaticResource KpiFrame}" Grid.Row="0" Grid.Column="0">
                    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto">
                        <Frame CornerRadius="18" Padding="4" HasShadow="False" BackgroundColor="Transparent" BorderColor="#E6E6E6" Grid.Column="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" VerticalOptions="Center">
                            <Label Text="▶" Style="{StaticResource KpiIconLabel}" />
                        </Frame>
                        <VerticalStackLayout Spacing="1" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Fill">
                            <Label Text="{Binding FirstIgnitionOnPoland, StringFormat='{}{0:t}', TargetNullValue='Brak danych'}" Style="{StaticResource KpiValue}" HorizontalOptions="End" HorizontalTextAlignment="End" />
                            <Label Text="Pierwsze uruchomienie (start pracy)" Style="{StaticResource KpiTitle}" HorizontalOptions="End" HorizontalTextAlignment="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource KpiFrame}" Grid.Row="0" Grid.Column="1">
                    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto">
                        <Frame CornerRadius="18" Padding="4" HasShadow="False" BackgroundColor="Transparent" BorderColor="#E6E6E6" Grid.Column="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" VerticalOptions="Center">
                            <Label Text="■" Style="{StaticResource KpiIconLabel}" />
                        </Frame>
                        <VerticalStackLayout Spacing="1" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Fill">
                            <Label Text="{Binding LastIgnitionOffPoland, StringFormat='{}{0:t}', TargetNullValue='Brak danych'}" Style="{StaticResource KpiValue}" HorizontalOptions="End" HorizontalTextAlignment="End" />
                            <Label Text="Ostatnie wyłączenie (koniec pracy)" Style="{StaticResource KpiTitle}" HorizontalOptions="End" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource KpiFrame}" Grid.Row="1" Grid.Column="0">
                    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto">
                        <Frame CornerRadius="18" Padding="4" HasShadow="False" BackgroundColor="Transparent" BorderColor="#E6E6E6" Grid.Column="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" VerticalOptions="Center">
                            <Label Text="h" Style="{StaticResource KpiIconLabel}" />
                        </Frame>
                        <VerticalStackLayout Spacing="1" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Fill">
                            <Label Text="{Binding HoursBetweenFirstOnAndLastOff, StringFormat='{}{0:F2} h', TargetNullValue='Brak danych'}" Style="{StaticResource KpiValue}" HorizontalOptions="End" HorizontalTextAlignment="End" />
                            <Label Text="Czas pracy" Style="{StaticResource KpiTitle}" HorizontalOptions="End" HorizontalTextAlignment="End" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

                <Frame Style="{StaticResource KpiFrame}" Grid.Row="1" Grid.Column="1">
                    <Grid ColumnDefinitions="36,*" RowDefinitions="Auto">
                        <Frame CornerRadius="18" Padding="4" HasShadow="False" BackgroundColor="Transparent" BorderColor="#E6E6E6" Grid.Column="0" WidthRequest="36" HeightRequest="36" HorizontalOptions="Start" VerticalOptions="Center">
                            <Label Text="km" Style="{StaticResource KpiIconLabel}" />
                        </Frame>
                        <VerticalStackLayout Spacing="1" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Fill">
                            <Label Text="{Binding DailyMileage, StringFormat='{}{0:F1} km', TargetNullValue='Brak danych'}" Style="{StaticResource KpiValue}" HorizontalOptions="End" HorizontalTextAlignment="End" />
                            <Label Text="Przebieg dzienny" Style="{StaticResource KpiTitle}" HorizontalOptions="End" HorizontalTextAlignment="End"/>
                        </VerticalStackLayout>
                    </Grid>
                </Frame>

            </Grid>

            <Label Text="Dane oparte na pierwszym uruchomieniu i ostatnim wyłączeniu w pobranym przedziale — czytelne podsumowanie pracy maszyny/pojazdu." FontSize="11" Opacity="0.7" HorizontalOptions="Start" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>