<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KAMICH.Pages.VehicleCustomizationPage"
             Title="Dostosuj pojazd">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <VerticalStackLayout Spacing="6">
                <Label Text="Dostosuj pojazd" FontSize="20" FontAttributes="Bold" />
                <Label Text="Wybierz ikonę i kolor pojazdu. Kliknij, aby zaznaczyć." 
                       FontSize="12" Opacity="0.8" />
            </VerticalStackLayout>
            
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto" Padding="0" VerticalOptions="Center">
                <StackLayout Orientation="Horizontal" Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64"
                            StrokeShape="Ellipse"
                            Stroke="LightGray" StrokeThickness="1"
                            Padding="0"
                            Background="{Binding Source={x:Reference ColorCollection}, Path=SelectedItem}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="Podgląd wybranego koloru">
                        <Label Text="{Binding Source={x:Reference IconCollection}, Path=SelectedItem.IconGlyph}"
                               FontFamily="FASolid"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="30"
                               AutomationProperties.IsInAccessibleTree="False"/>
                    </Border>
                </StackLayout>

                <Label Grid.Column="1"
                       VerticalOptions="Center"
                       Text="{Binding Source={x:Reference IconCollection}, Path=SelectedItem.Name, StringFormat='Wybrana ikona: {0}'}"
                       FontSize="14" />
                
                <Button Grid.Column="2"
                        Text="Zapisz"
                        VerticalOptions="Center"
                        Padding="10,6"
                        CornerRadius="8"
                        Clicked="SaveButton"
                        Background="#2196F3"
                        TextColor="White">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference IconCollection}, Path=SelectedItem}"
                                     Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <BoxView HeightRequest="1" Color="#E6E6E6" Margin="0,6"/>

            <Label Text="Wybierz ikonę" FontSize="16" FontAttributes="Bold" />

            <CollectionView x:Name="IconCollection"
                            SelectionMode="Single"
                            HeightRequest="220">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="10" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border WidthRequest="60" HeightRequest="60"
                                StrokeShape="Ellipse"
                                Stroke="LightGray" StrokeThickness="1"
                                Padding="0"
                                Margin="5"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Background="Transparent"
                                AutomationProperties.IsInAccessibleTree="True"
                                AutomationProperties.Name="{Binding Name}">
                            
      
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="SelectionStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#2196F3" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Background" Value="#E7F3FF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Label Text="{Binding IconGlyph}"
                                   FontFamily="FASolid"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="28"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <Label Text="Wybierz kolor" FontSize="16" FontAttributes="Bold" />

            <CollectionView x:Name="ColorCollection"
                            SelectionMode="Single"
                            HeightRequest="80">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="12"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border WidthRequest="44" HeightRequest="44"
                                StrokeShape="Ellipse"
                                Background="{Binding}"
                                Stroke="LightGray" StrokeThickness="1"
                                Padding="0"
                                Margin="4"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                AutomationProperties.IsInAccessibleTree="True">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="SelectionStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#2196F3" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Scale" Value="1.05" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <Label Text="Tip: kliknij ikonę, a następnie kolor, aby ustawić wygląd pojazdu." 
                   FontSize="12" Opacity="0.7" HorizontalOptions="Center" Margin="0,6"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
