<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KAMICH.Pages.VehicleCustomizationPage"
             Title="Dostosuj pojazd">

    <ScrollView>
        <VerticalStackLayout Padding="16,0" Spacing="14">

            <!-- Nagłówek strony -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Dostosuj pojazd" FontSize="20" FontAttributes="Bold" />
                <Label Text="Wybierz ikonę i kolor pojazdu. Kliknij, aby zaznaczyć." 
                       FontSize="12" Opacity="0.8" />
            </VerticalStackLayout>
            
            <!-- Podgląd + Zapisz -->
            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto" VerticalOptions="Center">
                <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64"
                            StrokeShape="Ellipse"
                            Stroke="LightGray" StrokeThickness="1"
                            Background="{Binding Source={x:Reference ColorCollection}, Path=SelectedItem}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="Podgląd wybranego koloru">
                        <Label Text="{Binding Source={x:Reference IconCollection}, Path=SelectedItem.IconGlyph}"
                               FontFamily="FASolid"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="30"
                               AutomationProperties.IsInAccessibleTree="False"/>
                    </Border>
                </StackLayout>

                <Label Grid.Column="1"
                       VerticalOptions="Center"
                       Text="{Binding Source={x:Reference IconCollection}, Path=SelectedItem.Name, StringFormat='Wybrana ikona: {0}'}"
                       FontSize="14" />
                
                <Button Grid.Column="2"
                        Text="Zapisz"
                        VerticalOptions="Center"
                        Padding="8,4"
                        CornerRadius="6"
                        Clicked="SaveButton"
                        Background="#2196F3"
                        TextColor="White">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button"
                                     Binding="{Binding Source={x:Reference IconCollection}, Path=SelectedItem}"
                                     Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Wybór ikony -->
            <Label Text="Wybierz ikonę" FontSize="16" FontAttributes="Bold" />
            <CollectionView x:Name="IconCollection"
                            SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border WidthRequest="60" HeightRequest="60"
                                StrokeShape="Ellipse"
                                Stroke="LightGray" StrokeThickness="1"
                                Margin="2"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Background="Transparent"
                                AutomationProperties.IsInAccessibleTree="True"
                                AutomationProperties.Name="{Binding Name}">
                            
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="SelectionStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#2196F3" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Background" Value="#E7F3FF" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Label Text="{Binding IconGlyph}"
                                   FontFamily="FASolid"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="28"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <!-- Wybór koloru -->
            <Label Text="Wybierz kolor" FontSize="16" FontAttributes="Bold" />
            <CollectionView x:Name="ColorCollection"
                            SelectionMode="Single"
                            HeightRequest="80">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border WidthRequest="44" HeightRequest="44"
                                StrokeShape="Ellipse"
                                Background="{Binding}"
                                Stroke="LightGray" StrokeThickness="1"
                                Margin="2"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                AutomationProperties.IsInAccessibleTree="True">

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="SelectionStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#2196F3" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="Scale" Value="1.05" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Parametry kosztów -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" >
                <Label Text="Włącz symulacje uzysków"
                       FontSize="14"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"/>
                <Switch x:Name="TrackingSwitch"
                        Grid.Column="1"
                        VerticalOptions="Center"/>
            </Grid>
            <VerticalStackLayout Spacing="8" IsVisible="{Binding Source={x:Reference TrackingSwitch}, Path=IsToggled}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Cena paliwa [zł/l]" FontSize="14"/>
                    <Entry x:Name="FuelPriceEntry"
                           Placeholder="np. 6.50"
                           Keyboard="Numeric"
                           HorizontalOptions="Fill"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Stawka godzinowa [zł/h]" FontSize="14"/>
                    <Entry x:Name="HourlyRateEntry"
                           Placeholder="np. 120"
                           Keyboard="Numeric"
                           HorizontalOptions="Fill"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Stawka operatora [zł/h]" FontSize="14"/>
                    <Entry x:Name="OperatorRateEntry"
                           Placeholder="np. 50"
                           Keyboard="Numeric"
                           HorizontalOptions="Fill"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2">
                    <Label Text="Pobór paliwa [L/h]" FontSize="14"/>
                    <Entry x:Name="FuelConsumptionEntry"
                           Placeholder="np. 12"
                           Keyboard="Numeric"
                           HorizontalOptions="Fill"/>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
