<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KAMICH.Pages.VehicleCustomizationPage"
             Title="Customize Vehicle">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="30">
            
            <!-- Sekcja ikon -->
            <Label Text="Choose Icon" FontSize="18" FontAttributes="Bold" />

            <CollectionView x:Name="IconCollection"
                            SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <!-- Grid 4 kolumny -->
                    <GridItemsLayout Orientation="Vertical" Span="4" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame WidthRequest="60" HeightRequest="60"
                               CornerRadius="30"
                               Padding="10"
                               Margin="5"
                               BorderColor="LightGray"
                               HasShadow="False">
                            <Label Text="{Binding IconGlyph}"
                                   FontFamily="FASolid"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   FontSize="28"/>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Sekcja kolorów -->
            <Label Text="Choose Color" FontSize="18" FontAttributes="Bold" />

            <CollectionView x:Name="ColorCollection"
                            SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <!-- Lista pozioma -->
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame WidthRequest="40" HeightRequest="40"
                               CornerRadius="20"
                               BackgroundColor="{Binding}"
                               Margin="5"
                               BorderColor="LightGray"
                               HasShadow="False" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
