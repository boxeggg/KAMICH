<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:micro="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             x:Class="KAMICH.Pages.LandingPage"
             Title="Strona główna"
             Shell.NavBarIsVisible="{OnIdiom Phone=True, Desktop=False}">

    <ContentPage.Resources>
        <Color x:Key="AccentGreen">#2E7D32</Color>
        <Color x:Key="AccentGreenLight">#E8F5E9</Color>
        <Color x:Key="AccentGreenDark">#1B5E20</Color>
        <Color x:Key="CardLight">#FFFFFF</Color>
        <Color x:Key="CardDark">#1E1E1E</Color>
        <Color x:Key="SurfaceLight">#F5F5F5</Color>
        <Color x:Key="SurfaceDark">#121212</Color>
        <Color x:Key="TabInactiveLight">#E0E0E0</Color>
        <Color x:Key="TabInactiveDark">#2C2C2C</Color>
        <Color x:Key="SubtextLight">#757575</Color>
        <Color x:Key="SubtextDark">#9E9E9E</Color>
    </ContentPage.Resources>

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
        <ScrollView>
            <Grid Padding="{OnIdiom Phone='16,12', Desktop='28,24'}"
                  ColumnDefinitions="{OnIdiom Phone='*', Desktop='3*,2*'}"
                  RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto,Auto', Desktop='Auto,Auto,Auto'}"
                  ColumnSpacing="{OnIdiom Phone=0, Desktop=24}"
                  RowSpacing="{OnIdiom Phone=16, Desktop=0}"
                  MaximumWidthRequest="{OnIdiom Phone=10000, Desktop=1500}"
                  HorizontalOptions="Fill">
                
                <Frame Padding="4" CornerRadius="12" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light={StaticResource TabInactiveLight}, Dark={StaticResource TabInactiveDark}}"
                       BorderColor="Transparent" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="{OnIdiom Phone=1, Desktop=2}">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                        <Frame x:Name="TabDaily" Padding="8,10" CornerRadius="10" HasShadow="False"
                               BorderColor="Transparent">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnDailyClicked" />
                            </Frame.GestureRecognizers>
                            <Label x:Name="TabDailyLabel" Text="Dzienny" HorizontalTextAlignment="Center"
                                   FontSize="13" FontAttributes="Bold" />
                        </Frame>

                        <Frame x:Name="TabMonthly" Padding="8,10" CornerRadius="10" HasShadow="False"
                               BorderColor="Transparent" Grid.Column="1">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMonthlyClicked" />
                            </Frame.GestureRecognizers>
                            <Label x:Name="TabMonthlyLabel" Text="Miesięczny" HorizontalTextAlignment="Center"
                                   FontSize="13" FontAttributes="Bold" />
                        </Frame>

                        <Frame x:Name="TabYearly" Padding="8,10" CornerRadius="10" HasShadow="False"
                               BorderColor="Transparent" Grid.Column="2">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnYearlyClicked" />
                            </Frame.GestureRecognizers>
                            <Label x:Name="TabYearlyLabel" Text="Roczny" HorizontalTextAlignment="Center"
                                   FontSize="13" FontAttributes="Bold" />
                        </Frame>
                    </Grid>
                </Frame>

                <!-- Desktop: shared background panel behind row 1 (both columns read as one surface) -->
                <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       IsVisible="{OnIdiom Phone=False, Desktop=True}"
                       Padding="0" CornerRadius="16" HasShadow="False"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                       BorderColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />

                <!-- LEFT / MAIN -->
                <VerticalStackLayout Grid.Row="1" Grid.Column="0"
                                     Margin="{OnIdiom Phone=0, Desktop='16,16,12,16'}"
                                     Spacing="{OnIdiom Phone=16, Desktop=20}"
                                     VerticalOptions="Start">
                <Label x:Name="apiStatus" Text="" IsVisible="False"
                     Grid.Row="1" />

                <!-- Segmented Tab Control -->

                <!-- Period Selector -->
                <Frame x:Name="DailyPickerFrame" Padding="8,6" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalOptions="Center">
                        <Button x:Name="DayPrevBtn" Grid.Column="0" Text="&#xF053;" FontFamily="FASolid" FontSize="12"
                                Padding="8,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" Clicked="OnDayPrev" />
                        <Label Text="&#xF073;" Grid.Column="1" FontFamily="FASolid" FontSize="16" VerticalOptions="Center" Margin="4,0,8,0"
                               TextColor="{StaticResource AccentGreen}" />
                        <Label x:Name="SelectedDateLabel" Grid.Column="2" Text="Dziś" FontSize="14" VerticalOptions="Center" />
                        <Button x:Name="DatePickerBtn" Grid.Column="3" Text="Zmień" FontSize="12"
                                Padding="10,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="{StaticResource AccentGreen}" TextColor="White"
                                Clicked="OnDatePickerClicked" />
                        <Button x:Name="DayNextBtn" Grid.Column="4" Text="&#xF054;" FontFamily="FASolid" FontSize="12"
                                Padding="8,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" Clicked="OnDayNext" />
                    </Grid>
                </Frame>

                <Frame x:Name="MonthPickerFrame" Padding="8,6" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                       IsVisible="False">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalOptions="Center">
                        <Button x:Name="MonthPrevBtn" Grid.Column="0" Text="&#xF053;" FontFamily="FASolid" FontSize="12"
                                Padding="8,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" Clicked="OnMonthPrev" />
                        <Label Text="&#xF073;" Grid.Column="1" FontFamily="FASolid" FontSize="16" VerticalOptions="Center" Margin="4,0,8,0"
                               TextColor="{StaticResource AccentGreen}" />
                        <Label x:Name="SelectedMonthLabel" Grid.Column="2" Text="" FontSize="14" VerticalOptions="Center" />
                        <Button x:Name="MonthNextBtn" Grid.Column="4" Text="&#xF054;" FontFamily="FASolid" FontSize="12"
                                Padding="8,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" Clicked="OnMonthNext" />
                    </Grid>
                </Frame>

                <Frame x:Name="YearPickerFrame" Padding="8,6" CornerRadius="10" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                       IsVisible="False">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" VerticalOptions="Center">
                        <Button x:Name="YearPrevBtn" Grid.Column="0" Text="&#xF053;" FontFamily="FASolid" FontSize="12"
                                Padding="8,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" Clicked="OnYearPrev" />
                        <Label Text="&#xF073;" Grid.Column="1" FontFamily="FASolid" FontSize="16" VerticalOptions="Center" Margin="4,0,8,0"
                               TextColor="{StaticResource AccentGreen}" />
                        <Label x:Name="SelectedYearLabel" Grid.Column="2" Text="" FontSize="14" VerticalOptions="Center" />
                        <Button x:Name="YearNextBtn" Grid.Column="4" Text="&#xF054;" FontFamily="FASolid" FontSize="12"
                                Padding="8,4" CornerRadius="8" HeightRequest="34"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}" Clicked="OnYearNext" />
                    </Grid>
                </Frame>

                <!-- Hidden DatePicker for system dialog -->
                <DatePicker x:Name="HiddenDatePicker" IsVisible="False" DateSelected="OnDateSelected" />

                <!-- Hero Income Card -->
                <Frame Padding="20" CornerRadius="16" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{StaticResource AccentGreen}">
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="PeriodTitle" Text="{Binding PeriodLabel}"
                               FontSize="13" TextColor="#C8E6C9" />
                        <Label Text="{Binding TotalIncome, StringFormat='{}{0:N2} zł'}"
                               FontSize="{OnIdiom Phone=34, Desktop=44}" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Szacowany przychód netto" FontSize="11" TextColor="#A5D6A7" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Loading -->
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False"
                                   HorizontalOptions="Center" Color="{StaticResource AccentGreen}" />

                </VerticalStackLayout>

                <!-- Chart  -->
                <Frame x:Name="ChartFrame" Padding="12" CornerRadius="12" HasShadow="False" BorderColor="Transparent"
                    Grid.Row="{OnIdiom Phone=3, Desktop=2}"
                    Grid.Column="0"
                    Grid.ColumnSpan="{OnIdiom Phone=1, Desktop=2}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                       IsVisible="False" >
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Historia przychodów" FontSize="13" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}" />
                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                <Button x:Name="ChartBarBtn" Text="Słupki" FontSize="11"
                                        Padding="8,2" CornerRadius="6" HeightRequest="28"
                                        BackgroundColor="{StaticResource AccentGreen}" TextColor="White"
                                        Clicked="OnChartBarClicked" />
                                <Button x:Name="ChartLineBtn" Text="Linia" FontSize="11"
                                        Padding="8,2" CornerRadius="6" HeightRequest="28"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#333333, Dark=#CCCCCC}"
                                        Clicked="OnChartLineClicked" />
                            </HorizontalStackLayout>
                        </Grid>
                            <VerticalStackLayout x:Name="ChartContainer" HeightRequest="{OnIdiom Phone=180, Desktop=400}"  />
                    </VerticalStackLayout>
                </Frame>

                <!-- Desktop: subtle vertical divider between the columns (centered in the gap) -->
                <BoxView Grid.Row="1" Grid.Column="1"
                         IsVisible="{OnIdiom Phone=False, Desktop=True}"
                         WidthRequest="1" HorizontalOptions="Start" VerticalOptions="Fill"
                         Margin="-12,18,0,18"
                         Color="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray950}}" />

                <!-- RIGHT COLUMN -->
                <VerticalStackLayout Grid.Row="{OnIdiom Phone=2, Desktop=1}"
                                     Grid.Column="{OnIdiom Phone=0, Desktop=1}"
                                     Margin="{OnIdiom Phone=0, Desktop='12,16,16,16'}"
                                     Spacing="{OnIdiom Phone=16, Desktop=20}"
                                     VerticalOptions="Start">

                <!-- Section Header -->
                <Label Text="Pojazdy" FontSize="15" FontAttributes="Bold" Margin="0,4,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}" />

                <!-- Vehicle List -->
                <CollectionView ItemsSource="{Binding Vehicles}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <Frame Padding="24" CornerRadius="12" HasShadow="False" BorderColor="Transparent"
                               BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                <Label Text="&#xf1b9;" FontFamily="FASolid" FontSize="32"
                                       HorizontalOptions="Center" Opacity="0.3" />
                                <Label Text="Brak śledzonych pojazdów" HorizontalOptions="Center"
                                       FontSize="14" Opacity="0.5" />
                                <Label Text="Dodaj pojazd w zakładce Flota" HorizontalOptions="Center"
                                       FontSize="12" Opacity="0.3" />
                            </VerticalStackLayout>
                        </Frame>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Padding="14" CornerRadius="12" HasShadow="False" Margin="0,0,0,8"
                                   BorderColor="Transparent"
                                   BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal" />
                                            <VisualState x:Name="PointerOver">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" VerticalOptions="Center">

                                    <!-- Vehicle Icon -->
                                    <Border WidthRequest="44" HeightRequest="44"
                                            StrokeShape="RoundRectangle 10"
                                            Stroke="Transparent" StrokeThickness="0"
                                            Background="{Binding Color}"
                                            HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Icon}" FontFamily="FASolid" FontSize="20"
                                               HorizontalOptions="Center" VerticalOptions="Center"
                                               TextColor="White" />
                                    </Border>

                                    <!-- Name -->
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontSize="15" FontAttributes="Bold"
                                           VerticalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" />

                                    <!-- Income -->
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center"
                                                         HorizontalOptions="End">
                                        <Label Text="{Binding Income, StringFormat='{}{0:N2} zł'}"
                                               FontSize="15" FontAttributes="Bold"
                                               HorizontalTextAlignment="End"
                                               TextColor="{StaticResource AccentGreen}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Fixed Costs -->
                <Frame Padding="14" CornerRadius="12" HasShadow="False" BorderColor="Transparent"
                       BackgroundColor="{AppThemeBinding Light={StaticResource CardLight}, Dark={StaticResource CardDark}}"
                       IsVisible="{Binding HasFixedCosts}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Koszty stałe" FontSize="13" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource SubtextLight}, Dark={StaticResource SubtextDark}}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Hotel" FontSize="13" Opacity="0.7" />
                            <Label Grid.Column="1" Text="{Binding FixedCostHotel, StringFormat='{}{0:N2} zł'}" FontSize="13" TextColor="#E53935" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Transport" FontSize="13" Opacity="0.7" />
                            <Label Grid.Column="1" Text="{Binding FixedCostTransport, StringFormat='{}{0:N2} zł'}" FontSize="13" TextColor="#E53935" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Serwis" FontSize="13" Opacity="0.7" />
                            <Label Grid.Column="1" Text="{Binding FixedCostService, StringFormat='{}{0:N2} zł'}" FontSize="13" TextColor="#E53935" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Inne" FontSize="13" Opacity="0.7" />
                            <Label Grid.Column="1" Text="{Binding FixedCostOther, StringFormat='{}{0:N2} zł'}" FontSize="13" TextColor="#E53935" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#EEE" HorizontalOptions="Fill" Margin="0,4" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Bilans netto" FontSize="14" FontAttributes="Bold" />
                            <Label Grid.Column="1" Text="{Binding NetIncome, StringFormat='{}{0:N2} zł'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource AccentGreen}" />
                        </Grid>

                        <Label Text="Dane szacunkowe" FontSize="10" Opacity="0.4" HorizontalOptions="End" />
                    </VerticalStackLayout>
                </Frame>

                </VerticalStackLayout>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
